# Dependencies and build output. The Electron runtime is 214 MB and the Rust
# toolchain cannot run on this host at all, so none of this belongs in git.
node_modules/
dist/
target/

# Downloaded model weights. Sotto fetches these on first run, never bundled,
# so they are reproducible state, not source.
*.onnx
*.gguf
*.bin

# Run logs and the audio scratch the probes write.
*.log
*.wav
probe/*.log
probe/*.wav
__pycache__/
*.pyc

# OS debris
Thumbs.db
.DS_Store

# The transcript history the panel writes (<date>/<HH>.md). It is the owner's
# own data, not source: it grows every time the app transcribes, so it must
# never enter a commit.
history/

# ── Run records, scratch and derived state (durability audit 2026-10-06) ─────
# Everything matched here is a RECORD of a run, a machine cache, or a scratch
# mutant/arm — never source. `git clean -fd` is allowed to take any of it.
# The proof instruments themselves (the oracle .py under _main/, the app, the
# worker) are TRACKED on purpose; only their output is ignored below.
*.err
*.out
*.jsonl
*.jsonl.err
*.mirror
*.stdout
*.pid

# _main/ holds the oracles (tracked) AND their captures. Only the captures go.
_main/*.txt
_main/*.png
_main/*.flac
_main/*.orig-*
_main/*-state.json
_main/_pwtest3.json
_main/asr-warmup.json
_main/probe-verify.json
_main/panel-visible-window-probe.json
_main/tap-restart-loop-oracle.json
_main/webview-hotreload-acceptance.json
_main/route-a-cu13.report.json
_main/runcmd-entry-report.json
_main/console-census-*.json
_main/run-cmd-exit-oracle-*.json
_main/vad-arm-*.json
_main/_probe/

# Per-run scratch inside the production trees. worker/models/ is the downloaded
# weights + their metadata; the model's OWN spec docs live in docs/model-specs/.
worker/models/
worker/runs/
worker/_probe/
worker/_e2e/
app/_legacy-electron/_hotreload/
app/_legacy-electron/_single-instance/
app/_legacy-electron/_dom-probe-*.json
app/verify/rustc/out/
app/webview/_flash-show-*.py
app/webview/_vis-live-*.py
worker/_sotto_worker_agcinert.py

# The model SIDECARS. `*.onnx` does NOT match `encoder.onnx.data`, so a whole fp32 model
# (2.32 GB) rode into a commit on 2026-10-08 and GitHub refused the push (LFS per-file limit 2 GiB).
*.onnx.data
*.safetensors
_main/_ordem-before/models/

# CORRECTION 2026-10-07: the line above said "the Rust toolchain cannot run on
# this host at all". That was FALSE and is measured wrong here. cargo 1.97.1
# works, `cargo build` in app/src-tauri returns rc=0, and it produced a valid
# 215.7 MB PE executable (H:\jcode-target-gnu\debug\sotto.exe). The only real
# blocker had been 2 lines of Tauri-1-era code, fixed in 5eca648.

# The moved ShadowPlay clone (Sotto). Source: docs/, specs/, src/, receipts/,
# AGENTS.md, ROADMAP.md.
#
# DURABILITY 2026-10-07: this tree arrived by a move from H:\aireplay and was
# for a while ENTIRELY UNTRACKED - `git clean -fd` would have taken 419 paths,
# i.e. the whole product. It is tracked now. Never ignore it wholesale again:
# if a subtree must stay untracked, ignore the ARTEFACTS, not the source.

_moved/aireplay/models/
_moved/aireplay/.hf-home/

# _main/ holds probes, oracles, logs and run artefacts. The ORACLE sources stay
# tracked on purpose - they are how every claim in this repo gets checked - and
# only their output is ignored.
_moved/aireplay/_main/logs/
_moved/aireplay/_main/runs/
_moved/aireplay/_main/build/
_moved/aireplay/_main/*/
_moved/aireplay/_main/*.log
_moved/aireplay/_main/*.out
_moved/aireplay/_main/*.err
_moved/aireplay/_main/*.pid
_moved/aireplay/_main/*.stdout
_moved/aireplay/_main/heartbeat.lock
_moved/aireplay/_main/heartbeat-run-*
_moved/aireplay/_main/_hb-*.lock
_moved/aireplay/_main/cargoprobe/

# Stray probes written to the old Sotto tree during the Tauri investigation.
_main/cargo-ver.*
_main/tauri-build*.out
_main/tauri-build*.err
_main/mcode-ver.*
_main/move-robocopy.log
_main/gitignore-ORIGINAL.txt
_main/_probe-sqlite-cron.py
_main/_probe-crons.py

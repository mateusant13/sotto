#!/bin/sh
# INSTALL or CHECK the versioned git hooks in this repo.
#
# WHY THIS EXISTS. Measured 2026-10-11T06:55:43Z: .git/hooks held 4 files, all Git LFS's,
# and none of mine. A hook written straight into .git/hooks is invisible to git, is not
# versioned, and is gone on the next clone. So the real scripts live in scripts/ and this
# installer writes the shims that point at them. Measured 2026-10-11T07:04:27Z: in this
# working tree the gate works, and a fresh clone would have NO gate at all -- because the
# shim lives in .git/hooks, which git never commits. That gap is what this file closes.
#
# USAGE
#   sh scripts/install-hooks          install every shim that is missing or stale
#   sh scripts/install-hooks --check  report what is installed, change nothing, exit 1
#                                    if any hook is missing or does not match its source
#
# NEVER OVERWRITES A FOREIGN HOOK. .git/hooks/pre-commit did not exist here, so it is
# written. If a file is already there and is NOT one of our shims, this refuses and says
# so rather than replacing someone else's work -- measured, the 4 Git LFS hooks in this
# repo are left alone, and the pre-commit one is ours.
#
# NO `set -e`, deliberately: the same trap that killed scripts/pre-commit's error message
# (a non-zero exit aborting the script before it could explain itself) applies here.
# Every decision is explicit.

REPO_ROOT=$(git rev-parse --show-toplevel) || {
  printf 'install-hooks: not inside a git repository\n' >&2
  exit 1
}
HOOKS_DIR="$REPO_ROOT/.git/hooks"
CHECK_ONLY=0
[ "$1" = "--check" ] && CHECK_ONLY=1

# The shims: name -> the versioned script it execs.
HOOKS="pre-commit:pre-commit"

# CHAINED HOOKS. post-checkout and post-merge are the two moments a clone can end up
# with no gate at all, and both slots are already occupied by Git LFS in this repo
# (measured 2026-10-11T07:13:45Z: 360 B and 354 B, both running `git lfs <name>`).
#
# These are NOT replaced. The LFS body is copied aside once to <name>.lfs-original, the
# installed hook runs it first and then runs install-hooks --check. If the LFS body ever
# changes, --check compares the two and reports the hook as STALE rather than silently
# dropping LFS. Replacing a hook that belongs to someone else is how you lose data
# checkout; chaining is the only safe order.
CHAINED="post-checkout post-merge"

status=0
installed=0
refused=0

chain_one() {
  name="$1"
  dest="$HOOKS_DIR/$name"
  keep="$HOOKS_DIR/$name.lfs-original"
  if [ ! -f "$dest" ]; then
    printf '  ABSENT           %s -- no hook here to chain onto; install-hooks --check will still report the gate\n' "$name"
    return 0
  fi
  # Ours already?  The marker lives at the top; ours also starts with the shim header.
  if head -n 2 "$dest" | grep -q 'sotto-hook-chain'; then
    printf '  ok               %s (already chained)\n' "$name"
    return 0
  fi
  # Preserve the foreign body once, then chain around it.
  cp "$dest" "$keep"
  {
    printf '#!/bin/sh\n'
    printf '# sotto-hook-chain: installed by scripts/install-hooks. The original body of this\n'
    printf '# hook is preserved at %s.lfs-original and runs FIRST, so Git LFS keeps working.\n' "$name"
    printf '%s\n' "# ORIGINAL BODY"
    cat "$keep"
    printf '\n'
    printf '%s\n' "# THEN: reinstall and report every hook this repo owns"
    printf 'sh "$(git rev-parse --show-toplevel)/scripts/install-hooks" >/dev/null 2>&1\n'
    printf 'sh "$(git rev-parse --show-toplevel)/scripts/install-hooks" --check\n'
  } > "$dest"
  printf '  CHAINED          %s -> LFS body preserved at %s.lfs-original\n' "$name" "$name"
  installed=$((installed+1))
}

if [ "$CHECK_ONLY" -eq 0 ]; then
  for c in $CHAINED; do
    chain_one "$c"
  done
fi

for pair in $HOOKS; do
  name=${pair%%:*}
  target="$REPO_ROOT/scripts/${pair##*:}"
  dest="$HOOKS_DIR/$name"

  if [ ! -f "$target" ]; then
    printf '  MISSING SOURCE  %s -- %s is not in the repo\n' "$name" "$target"
    status=1
    continue
  fi

  expected=$(printf '#!/bin/sh\n# Installed by scripts/install-hooks. Source of truth: scripts/%s\nexec sh "$(git rev-parse --show-toplevel)/scripts/%s" "$@"\n' "$name" "$name")

  if [ -f "$dest" ]; then
    current=$(cat "$dest")
    if [ "$current" = "$expected" ]; then
      printf '  ok               %s (matches its source)\n' "$name"
      continue
    fi
    if printf '%s' "$current" | grep -q 'Installed by scripts/install-hooks'; then
      # Ours, but stale. Safe to refresh.
      if [ "$CHECK_ONLY" -eq 1 ]; then
        printf '  STALE            %s -- installed shim differs from the current installer\n' "$name"
        status=1
      else
        printf '%s' "$expected" > "$dest"
        printf '  REFRESHED        %s\n' "$name"
        installed=$((installed+1))
      fi
      continue
    fi
    # Someone else's hook. Never replace it.
    printf '  REFUSED          %s -- a foreign hook is already there, left untouched\n' "$name"
    refused=$((refused+1))
    continue
  fi

  if [ "$CHECK_ONLY" -eq 1 ]; then
    printf '  ABSENT           %s -- this clone has NO gate until you run install-hooks\n' "$name"
    status=1
    continue
  fi

  printf '%s' "$expected" > "$dest"
  printf '  INSTALLED        %s -> scripts/%s\n' "$name" "$name"
  installed=$((installed+1))
done

# Report what we deliberately left alone, so the count is not a surprise.
others=$(ls -1 "$HOOKS_DIR" 2>/dev/null | grep -v '\.sample$' | wc -l)
printf '  foreign hooks left untouched: %s\n' "$((others))"

# CHECK THE CHAINED HOOKS. Two things can be wrong and they are different failures:
# the chain marker is missing (nobody chained us), or the LFS body has changed since we
# copied it aside (we would be running a stale copy of someone else's hook). The second
# is the one that matters and the one nobody would notice.
for c in $CHAINED; do
  dest="$HOOKS_DIR/$c"
  keep="$HOOKS_DIR/$c.lfs-original"
  if [ ! -f "$dest" ]; then
    printf '  ABSENT           %s -- not installed\n' "$c"
    status=1
    continue
  fi
  if ! head -n 2 "$dest" | grep -q 'sotto-hook-chain'; then
    printf '  UNCHAINED        %s -- the hook exists but ours is not wired into it\n' "$c"
    status=1
    continue
  fi
  if [ ! -f "$keep" ]; then
    printf '  NO-ORIGINAL      %s -- chained, but %s.lfs-original is missing, so the foreign body cannot be verified\n' "$c" "$c"
    status=1
    continue
  fi
  if sed -n '/^# ORIGINAL BODY$/,/^# THEN:/p' "$dest" | grep -v '^# ORIGINAL BODY$' | grep -v '^# THEN:' | grep -v '^$' | diff -q - "$keep" >/dev/null 2>&1; then
    printf '  ok               %s (chained; LFS body byte-identical to %s.lfs-original)\n' "$c" "$c"
  else
    printf '  STALE            %s -- the LFS body in the hook no longer matches %s.lfs-original; re-run install-hooks\n' "$c" "$c"
    status=1
  fi
done

if [ "$CHECK_ONLY" -eq 1 ]; then
  [ "$status" -eq 0 ] && printf '  CHECK OK\n' || printf '  CHECK FAILED\n'
  exit "$status"
fi

printf '  done: %s installed or refreshed, %s foreign left alone\n' "$installed" "$refused"
exit 0
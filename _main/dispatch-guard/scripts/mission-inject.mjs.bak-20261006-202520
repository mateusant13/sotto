#!/usr/bin/env node
// mission-inject.mjs -- put the owner's STANDING MISSION into context at every session start.
//
// WHY THIS EXISTS, and it is not redundancy for its own sake. Measured 2026-10-06:
// the cron scheduler is the class `iV` in chunks/chunk-U7ACBEGU.js. It keeps its job
// list in an in-memory `Map` (`this.jobs`), and it reads the database exactly once:
//
//     start(e={}){ if(!this.started){ this.started=!0;
//         try{ this.restoreActiveJobs(e.restorePersistedJobExecution!==!1) ...
//     restoreActiveJobs(e){ let n=this.requireStarted().select(mtt).from(Di).all(); ...
//
// So a cron row written to the store CANNOT fire in the process that is already
// running. The mcode process here started 10:29:09; the consolidated cron row was
// re-armed at 10:57:32, i.e. 28 min AFTER that start. Verified: `cron-verify.py`
// returned rc=1 SILENT with 20 heartbeats over a 300 s ceiling, and
// `cron-scheduler-status.py` showed the newest run of ANY cron was 63 min old.
//
// THE CONSEQUENCE: the row is correct and WILL be hydrated at the next mcode start
// (the projection `mtt` carries no WHERE; `restoreJob()` gates only on
// `state === "active"`, which it now is). Until then nothing wakes the agent on a
// timer. A mission that only exists inside a cron prompt is a mission that does not
// exist while the owner is away.
//
// THEREFORE this hook carries the same mission through a second, independent door:
// SessionStart, which runs on every session. Two doors, one mission. If the cron
// works, the agent gets it every 3 minutes; if the cron is dead, the agent still
// gets it the moment any session starts. It never blocks -- only additionalContext --
// and it always exits 0, because a hook that wedges session start is worse than a
// hook that does not run.
import { readFileSync, appendFileSync, mkdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { homedir } from 'node:os';
// The five below exist ONLY for `--selftest`. The live path never touches them.
import { existsSync, mkdtempSync, writeFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { tmpdir } from 'node:os';
import { fileURLToPath } from 'node:url';

const MISSION = process.env.MINIMAX_MISSION_FILE
  || 'I:\\!manager\\scripts\\cron-mission-prompt.md';
const MAX_CTX = 2600;

function home() {
  return process.env.MINIMAX_HOME || join(process.env.USERPROFILE || homedir(), '.minimax');
}

// ---------------------------------------------------------------------------
// --selftest. Nothing here runs unless the operator passes the flag.
//
// WHY IT IS IN THIS FILE AND NOT A SIBLING. Three tools in this package passed
// their own selftest and were unreachable (optchat-view, deny-fail-silent 14/14,
// ticket-dispatch-record) -- built, never fired. And this one had NO selftest at
// all, which is strictly worse: a hook with no arms cannot be shown to fail, so
// "it fired once and worked" is the entire evidence for the owner's mission
// reaching every session. Arm 6 closes that by reading hooks.json, because a
// green that only proves the component proves the component.
//
// rc: 0 every arm passed | 1 a real RED | 2 an arm could not conclude | 3 usage.
if (process.argv.includes('--selftest')) {
  const SELF = fileURLToPath(import.meta.url);
  const DIR = dirname(SELF);
  const DISPATCH = join(DIR, 'hook-dispatch.mjs');
  const HOOKS_JSON = join(DIR, '..', 'hooks', 'hooks.json');
  // Law 1 of the lane contract: this session is under ABSOLUTE quarantine and is
  // never revived, never messaged, never touched. It is named here as an ID in a
  // fixture -- nothing is sent to it. The arm exists because this hook is the
  // second door for the owner's mission, and a door that a session exemption can
  // lock is not a door.
  const QUARANTINED = 'mvs_19e3d42432374e52a03ba256db70a8b5';

  let pass = 0, fail = 0, noVerdict = 0;
  // `detail` is a MEASUREMENT, never a claim about the verdict. A PASS line that
  // printed "no TRUNCATED marker on a truncated payload" would read as a failure
  // to the human deciding whether to trust this gate, and a gate nobody trusts is
  // a gate nobody runs. When a measurement only makes sense on failure, build it
  // conditionally.
  function arm(name, ok, detail, undetermined) {
    const d = typeof detail === 'function' ? detail() : detail;
    if (ok) { pass++; console.log(`  PASS  ${name}${d ? '  -- ' + d : ''}`); }
    else if (undetermined) { noVerdict++; console.log(`  NO-VERDICT  ${name}${d ? '  -- ' + d : ''}`); }
    else { fail++; console.log(`  FAIL  ${name}${d ? '  -- ' + d : ''}`); }
  }

  function tmp() { return mkdtempSync(join(tmpdir(), 'mission-selftest-')); }

  // Never pipe a native command when you need its exit code; spawnSync gives the
  // rc and the streams together, which is the whole point of these arms.
  // `target` is passed as argv[2] -- hook-dispatch.mjs execs exactly that path and
  // exits 0 with no output if it is absent, which would make every dispatcher arm
  // below pass without ever running anything.
  function run(script, { env = {}, stdin = '', target } = {}) {
    const args = target ? [script, target] : [script];
    const r = spawnSync(process.execPath, args, {
      input: stdin, encoding: 'utf8', timeout: 10000, maxBuffer: 8 * 1024 * 1024,
      env: { ...process.env, ...env },
    });
    return { rc: r.status, out: r.stdout || '', err: r.stderr || '' };
  }

  function writeMission(dir, body, name = 'mission.md') {
    const p = join(dir, name);
    writeFileSync(p, body, 'utf8');
    return p;
  }

  function parseCtx(out) {
    try {
      const j = JSON.parse(out);
      return { ok: true, event: j?.hookSpecificOutput?.hookEventName, ctx: j?.hookSpecificOutput?.additionalContext || '' };
    } catch (e) { return { ok: false, event: null, ctx: '', err: String(e && e.message) }; }
  }

  // The exemption list is read FROM hook-dispatch.mjs, never retyped here. A
  // hardcoded copy in the test is a second truth that goes stale silently, and the
  // arms below would keep passing against a list nothing enforces.
  function hardcodedExempt() {
    try {
      const src = readFileSync(DISPATCH, 'utf8');
      const m = src.match(/const\s+FALLBACK_EXEMPT\s*=\s*\[([\s\S]*?)\];/);
      if (!m) return null;
      const ids = [...m[1].matchAll(/'(mvs_[0-9a-f]+)'/g)].map((x) => x[1]);
      return ids.length ? ids : null;
    } catch { return null; }
  }

  const ROW = (id, text) => `| ${id} | *"${text}"* | a column that is not read |`;
  const TABLE = (rows) => ['| id | his words | what it becomes |', '|---|---|---|', ...rows].join('\n');

  console.log('selftest: mission-inject.mjs');

  // A1 - the mission file is present. The hook must EMIT, as the hook contract,
  // not print prose: a hook whose output the runtime cannot parse is silence.
  const a1dir = tmp();
  const a1mission = writeMission(a1dir, TABLE([
    ROW('700001', 'FIRST OWNER QUOTE'),
    ROW('700002', 'SECOND OWNER QUOTE'),
  ]));
  const a1 = run(SELF, { env: { MINIMAX_MISSION_FILE: a1mission, MINIMAX_HOME: tmp() } });
  const a1p = parseCtx(a1.out);
  arm('A1 present mission -> rc 0', a1.rc === 0, `rc=${a1.rc}${a1.err ? ' ' + a1.err.slice(0, 120) : ''}`);
  arm('A1 output parses as the hook contract', a1p.ok && typeof a1p.ctx === 'string' && a1p.ctx.length > 0,
    a1p.ok ? `ctx=${a1p.ctx.length}B` : `unparseable: ${a1p.err || a1.out.slice(0, 120)}`);
  arm('A1 hookEventName is SessionStart', a1p.event === 'SessionStart', `event=${a1p.event}`);
  const ids = (s) => (s.match(/\[\d{6}\]/g) || []).length;

  arm('A1 quotes are verbatim and carry their ids',
    a1p.ctx.includes('FIRST OWNER QUOTE') && a1p.ctx.includes('[700001]') && a1p.ctx.includes('SECOND OWNER QUOTE'),
    () => `ids=${ids(a1p.ctx)} of 2 expected, verbatim-text-present=${a1p.ctx.includes('FIRST OWNER QUOTE')}`);
  arm('A1 no truncation marker on a small mission', !a1p.ctx.includes('TRUNCATED'), `ctx=${a1p.ctx.length}B`);

  // A2 - THE ARM THAT MATTERS MOST. The mission file missing must be rc 0 and
  // ZERO bytes on stdout. Not "a message about a missing file": the payload is
  // parsed by the runtime, and a non-JSON byte here is a session start that
  // wedges or a context that reads as corruption. Silence is the contract.
  {
    const a2dir = tmp();
    const absent = join(a2dir, 'this-file-does-not-exist.md');
    const a2 = run(SELF, { env: { MINIMAX_MISSION_FILE: absent, MINIMAX_HOME: tmp() } });
    arm('A2 missing mission -> rc 0', a2.rc === 0, `rc=${a2.rc}${a2.err ? ' ' + a2.err.slice(0, 120) : ''}`);
    arm('A2 missing mission -> emits NOTHING (never wedges a session start)',
      a2.out.length === 0, `stdout=${a2.out.length}B ${JSON.stringify(a2.out.slice(0, 80))}`);

    // The same, through the seam the runtime actually uses.
    const a2w = run(DISPATCH, {
      stdin: JSON.stringify({ hook_event_name: 'SessionStart', session_id: 'mvs_selftest0000000000000000000000' }),
      env: { MINIMAX_MISSION_FILE: absent, MINIMAX_HOME: tmp() },
    });
    arm('A2 through hook-dispatch -> rc 0 and no bytes',
      a2w.rc === 0 && a2w.out.length === 0, `rc=${a2w.rc} stdout=${a2w.out.length}B`);
  }

  // A3 - a mission file whose quote rows do not parse. MEASURED on the LIVE file
  // 2026-10-06: 8 table rows, 6 of them data rows, and only 5 parse. The sixth,
  // `| 195021 / 195085 |`, carries two ids in one cell and the regex wants
  // exactly six digits, so the row is DROPPED -- including "eu quero voltar com
  // TUDO que eu ja pedi feito". So the zero-parse case is not hypothetical: it is
  // the direction this file is already moving, and today it emits the header
  // "His words, verbatim from the mission file" above an EMPTY list. A header
  // that promises quotes and delivers none is the silent failure.
  {
    const a3dir = tmp();
    const prose = [
      '# THE MISSION', '', 'The owner is away. Do the work. No table here at all.',
      '| this is | not | a quote row |', '| 12 | *"too short an id"* | x |',
    ].join('\n');
    const a3mission = writeMission(a3dir, prose, 'prose-mission.md');
    const a3 = run(SELF, { env: { MINIMAX_MISSION_FILE: a3mission, MINIMAX_HOME: tmp() } });
    const a3p = parseCtx(a3.out);
    arm('A3 no parseable rows -> rc 0 (never wedges)', a3.rc === 0, `rc=${a3.rc}`);
    arm('A3 no parseable rows -> the absence is MARKED',
      a3p.ok && /NO PARSEABLE QUOTE ROWS/i.test(a3p.ctx),
      () => `marker=${a3p.ok && /NO PARSEABLE QUOTE ROWS/i.test(a3p.ctx) ? 'present' : 'ABSENT'}`);
    arm('A3 no parseable rows -> claims no quote ids',
      ids(a3p.ctx) === 0, `ids=${ids(a3p.ctx)}`);
    arm('A3 an empty digest names the file it could not quote',
      a3p.ok && a3p.ctx.includes(a3mission),
      () => `path-in-marker=${a3p.ok && a3p.ctx.includes(a3mission)}, fed=${a3mission}`);
  }

  // A4 - oversized. MAX_CTX exists so the injected context cannot crowd out the
  // owner's actual prompt, and a truncation that is not MARKED is worse than no
  // truncation: the agent reads a mission that stops mid-sentence and believes he
  // has read it.
  {
    const a4dir = tmp();
    const fat = 'A'.repeat(900);
    const a4mission = writeMission(a4dir, TABLE([700100, 700101, 700102, 700103, 700104, 700105].map((id) => ROW(id, fat))), 'fat-mission.md');
    const a4 = run(SELF, { env: { MINIMAX_MISSION_FILE: a4mission, MINIMAX_HOME: tmp() } });
    const a4p = parseCtx(a4.out);
    const wasTruncated = a4p.ok && a4p.ctx.length >= MAX_CTX - 64;
    arm('A4 oversized mission -> rc 0 and parses', a4.rc === 0 && a4p.ok, `rc=${a4.rc}`);
    arm('A4 oversized mission -> actually hit the ceiling', wasTruncated,
      `ctx=${a4p.ctx.length}B ceiling=${MAX_CTX}B`);
    arm('A4 truncation is MARKED, never silent',
      a4p.ok && a4p.ctx.includes('TRUNCATED'),
      () => `marker=${a4p.ok && a4p.ctx.includes('TRUNCATED') ? 'present' : 'ABSENT'}`);
    arm('A4 injected context stays within MAX_CTX',
      a4p.ok && a4p.ctx.length <= MAX_CTX, `ctx=${a4p.ctx.length}B`);
  }

  // A5 - THE EXEMPTION CANNOT KILL IT. hook-dispatch.mjs skips the handler for an
  // exempt session, and it once silently killed the p0-ratchet hook that way.
  // mission-inject survives ONLY because it is named in ALWAYS_RUN. That is a
  // list entry, and a list entry with no arm behind it is a comment.
  //
  // The arm is TWO-SIDED on purpose. Feeding an exempt session and seeing output
  // proves nothing unless the exemption is shown to be armed: if the dispatcher
  // were not exempting anything, every one of these would "pass" while the
  // property under test was absent. The probe is the control that makes the
  // positive arm mean something.
  {
    const home = tmp();
    writeFileSync(join(home, 'session-exemptions.json'),
      JSON.stringify({ exempt_sessions: [QUARANTINED] }), 'utf8');
    const probe = join(tmp(), 'zz-mission-selftest-probe.mjs');
    writeFileSync(probe, "process.stdout.write('PROBE_EMITTED');\n", 'utf8');
    const mission = writeMission(tmp(), TABLE([ROW('700200', 'QUARANTINE SURVIVES THE EXEMPTION')]));
    const env = { MINIMAX_MISSION_FILE: mission, MINIMAX_HOME: home };
    const payload = (sid) => JSON.stringify({ hook_event_name: 'SessionStart', session_id: sid });

    // CONTROL 1: the exempt session really does switch a normal handler OFF.
    // The target is the PROBE, a script that always prints. If the dispatcher
    // skipped nothing, this arm would FAIL -- which is the whole reason it is here.
    const ctrl = run(DISPATCH, { target: probe, stdin: payload(QUARANTINED), env });
    arm('A5 control: an exempt session DOES suppress a normal handler',
      ctrl.out.length === 0 && !ctrl.out.includes('PROBE_EMITTED'),
      `probe output=${JSON.stringify(ctrl.out.slice(0, 40))} - the exemption is armed`);

    // CONTROL 2: and that same probe DOES run for a session that is not exempt, so
    // control 1 is the exemption and not a dead probe.
    const ctl2 = run(DISPATCH, { target: probe, stdin: payload('mvs_notexempt0000000000000000000000'), env });
    arm('A5 control: the same handler DOES run for a non-exempt session',
      ctl2.out.includes('PROBE_EMITTED'), `probe output=${JSON.stringify(ctl2.out.slice(0, 40))}`);

    // THE ARM: the quarantined session, LISTED as exempt, still gets the mission.
    const a5 = run(DISPATCH, { target: SELF, stdin: payload(QUARANTINED), env });
    const a5p = parseCtx(a5.out);
    arm('A5 QUARANTINED session + listed exempt -> STILL emits context',
      a5.rc === 0 && a5p.ok && a5p.ctx.includes('QUARANTINE SURVIVES THE EXEMPTION'),
      `rc=${a5.rc} out=${a5.out.length}B - ${a5p.ok ? 'injected' : 'NOT INJECTED'}`);
    arm('A5 emits a well-formed payload, not a fragment', a5p.ok && a5p.event === 'SessionStart' && a5p.ctx.length > 0,
      `event=${a5p.event}`);

    // mission-inject is in ALWAYS_RUN; assert the name is still there, so deleting
    // the entry turns this suite RED instead of silently disabling the mission.
    const src = readFileSync(DISPATCH, 'utf8');
    const alwaysBlock = src.match(/const\s+ALWAYS_RUN\s*=\s*\[([\s\S]*?)\];/);
    arm('A5 mission-inject is named in ALWAYS_RUN',
      !!alwaysBlock && /['"]mission-inject['"]/.test(alwaysBlock[1]),
      alwaysBlock ? 'found' : 'ALWAYS_RUN block not readable');

    // The list hook-dispatch falls back to when no exemptions file exists -- which
    // is THIS HOST's state right now (measured: no session-exemptions.json). If the
    // quarantined id is not in it, the arm below says so rather than implying a
    // coverage it does not have.
    const fb = hardcodedExempt();
    arm('A5 fallback exemption list is readable from hook-dispatch.mjs', !!fb && fb.length > 0,
      fb ? fb.join(',') : 'could not read FALLBACK_EXEMPT');
    if (fb) {
      // No exemptions file at all: the fallback list is what applies.
      const a5d = run(DISPATCH, { target: SELF, stdin: payload(QUARANTINED), env: { MINIMAX_MISSION_FILE: mission, MINIMAX_HOME: tmp() } });
      const a5dp = parseCtx(a5d.out);
      arm('A5 QUARANTINED session, no exemptions file -> still emits',
        a5d.rc === 0 && a5dp.ok && a5dp.ctx.includes('QUARANTINE SURVIVES THE EXEMPTION'),
        `quarantined id is ON the fallback list: ${fb.includes(QUARANTINED)} - out=${a5d.out.length}B`);

      // A session that IS on the fallback list, with an exemptions file that says
      // so. This is the owner's own CLI session: the one the exemption was written
      // for, and the one that once lost the p0-ratchet hook to it.
      const homeFb = tmp();
      writeFileSync(join(homeFb, 'session-exemptions.json'), JSON.stringify({ exempt_sessions: fb }), 'utf8');
      const a5e = run(DISPATCH, {
        target: SELF,
        stdin: payload(fb[0]),
        env: { MINIMAX_MISSION_FILE: mission, MINIMAX_HOME: homeFb },
      });
      arm('A5 a session GENUINELY on the exemption list -> still emits',
        a5e.rc === 0 && parseCtx(a5e.out).ctx.includes('QUARANTINE SURVIVES THE EXEMPTION'),
        `session=${fb[0]} out=${a5e.out.length}B`);
    }
  }

  // A6 - THE WIRING ARM. Built is not wired. Three tools in this package passed
  // their own selftest and were unreachable; the manifest is the file a reader
  // actually opens, so the manifest is what this asserts.
  {
    let hooks = null;
    try { hooks = JSON.parse(readFileSync(HOOKS_JSON, 'utf8')); } catch { /* arm fails below */ }
    let boundEvent = null, named = false;
    if (hooks && hooks.hooks) {
      for (const [event, arr] of Object.entries(hooks.hooks)) {
        for (const h of (Array.isArray(arr) ? arr : [arr])) {
          if (JSON.stringify(h).includes('mission-inject.mjs')) { named = true; boundEvent = event; }
        }
      }
    }
    arm('A6 hook is NAMED in hooks.json', named, named ? '' : 'hooks.json unreadable or the entry is gone');
    arm('A6 hook is BOUND to an event', !!boundEvent, `event=${boundEvent}`);
    arm('A6 the event it is bound to is the event it emits',
      !!boundEvent && boundEvent === parseCtx(a1.out).event,
      () => `manifest=${boundEvent} emitted=${parseCtx(a1.out).event}`);
    arm('A6 it runs through the dispatcher the manifest names',
      !!boundEvent && readFileSync(HOOKS_JSON, 'utf8').includes('hook-dispatch.mjs'),
      'the seam forwards stdin, stdout and rc verbatim');
  }

  // The live mission file, measured, so the suite's own ceiling claim is honest.
  {
    const live = run(SELF, { env: { MINIMAX_HOME: tmp() } });
    const p = parseCtx(live.out);
    arm('A7 the LIVE mission file yields a parseable payload',
      live.rc === 0 && p.ok && p.ctx.length > 0,
      `rc=${live.rc} ctx=${p.ctx.length}B truncated=${p.ok ? p.ctx.includes('TRUNCATED') : 'n/a'}`);
    if (p.ok) {
      const ids = (p.ctx.match(/\[\d{6}\]/g) || []).length;
      arm('A7 live digest carries at least one quote', ids >= 1, `ids=${ids}`);
    }
  }

  console.log(`\n${pass} passed, ${fail} failed${noVerdict ? `, ${noVerdict} no-verdict` : ''}`);
  process.exit(fail ? 1 : noVerdict ? 2 : 0);
}

try {
  const raw = readFileSync(MISSION, 'utf8');
  if (!raw.trim()) process.exit(0);

  // The digest is the owner's own words, not my summary of them. A paraphrase is a
  // second thing that can drift from the first.
  const quotes = [];
  for (const line of raw.split('\n')) {
    const m = line.match(/^\|\s*(\d{6})\s*\|\s*\*"([^*]+)"\*/);
    if (m) quotes.push(`  [${m[1]}] "${m[2]}"`);
  }

  const ctx = [
    '[OWNER MISSION — active for this whole session]',
    '',
    'The owner is away and expects to return to EVERYTHING he asked for, already done.',
    'His words, verbatim from the mission file (ids are prompt ids you can search with',
    '`python scripts\\prompt-search.py --source cli --id <n>` in I:\\!manager):',
    ...(quotes.length
      ? quotes.slice(0, 6)
      : [
          `  [NO PARSEABLE QUOTE ROWS] the verbatim digest above is EMPTY. ${MISSION}`,
          '  could not be quoted -- its table shape changed, or it is prose. That is NOT',
          '  a silent pass: open that file and read the mission yourself.',
        ]),
    '',
    'THE FULL MISSION, with the operational form of each item:',
    `  I:\\!manager\\scripts\\cron-mission-prompt.md  (${raw.length} bytes) — READ IT BEFORE PLANNING.`,
    '',
    'THE FLEET TARGET IS 50 SUBAGENTS RUNNING (his words: "em breve tu tem que ser ate',
    '50 subagents rodando. nao esquece. bota no cron."). Running, not dispatched-over-time:',
    '"succeeded" is not "running". The cap is proven enforced; above 50 it returns rc=2',
    'REFUSED rather than truncating. If the runtime refuses a batch with its own',
    'concurrency limit, that number is your real ceiling — report it as a measurement.',
    '',
    'KNOWN LIMIT SO YOU DO NOT CHASE IT: the cron scheduler hydrates from the store only',
    'at process start (restoreActiveJobs, in-memory Map). A cron row written while',
    'mcode is already running does NOT fire until the next start. The consolidated cron',
    'd43fb9be-283d-4dd3-8e73-d9fb562fd181 is armed (state=active, */3, mission prompt)',
    'and will run on the next start. THIS HOOK is the second door.',
    '',
    'Report contract: 2+ passes, the 2nd must try to REFUTE the 1st; one friction item',
    'per pass to state/friction/FRICTION-LEDGER.md; every count carries POPULATION and',
    'WINDOW; end with the exact line "Does your implementation meet the spec? ...".',
  ].join('\n');

  const out = ctx.length > MAX_CTX ? ctx.slice(0, MAX_CTX - 40) + '\n[mission] TRUNCATED.' : ctx;

  try {
    mkdirSync(join(home(), 'hook-dispatch-heartbeat'), { recursive: true });
    appendFileSync(join(home(), 'hook-dispatch-heartbeat', 'mission-inject.log'),
      `${Date.now()} injected=${out.length}B source=${MISSION}\n`);
  } catch { /* telemetry must never wedge a session start */ }

  process.stdout.write(JSON.stringify({
    hookSpecificOutput: { hookEventName: 'SessionStart', additionalContext: out },
  }));
} catch {
  process.exit(0);   // missing mission file must never wedge session start
}